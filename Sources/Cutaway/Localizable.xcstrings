      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoyu içe al…"
          }
        }
      }
    },
    "Intent extraction and scoring run on this. Use an Anthropic API key (sk-ant-api…) or a Claude subscription setup token (sk-ant-oat…, created with 'claude setup-token'). Stored only in this Mac's Keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niyet çıkarma ve puanlama bununla çalışır. Anthropic API anahtarı (sk-ant-api…) ya da Claude aboneliği setup token'ı (sk-ant-oat…, 'claude setup-token' ile üretilir) kullanabilirsin. Yalnız bu Mac'in Keychain'inde saklanır."
          }
        }
      }
    },
