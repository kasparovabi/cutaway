    "Cutaway runs these on your Mac for transcription, search, and downloads.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutaway bu araçları transkript, arama ve indirme için Mac'inde çalıştırır."
